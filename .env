# Blood Mithra — Environment
# XAMPP MySQL uses hostname 127.0.0.1 (or localhost) with user root and no password
# by default. Adjust DB_NAME if your database is different.

PORT=5000

# Database (MySQL — XAMPP default)
DATABASE_URL=mysql://root:@127.0.0.1:3306/app_db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=app_db

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-in-production

# OTP
OTP_EXPIRY_MINUTES=10
